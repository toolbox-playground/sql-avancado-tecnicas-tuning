# Ignorar as dependências do Node.js
/node_modules

# Ignorar arquivos de log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Ignorar caches de pacotes
/package-lock.json
/yarn.lock

# Ignorar arquivos de build
/dist
/build
/out
/es
/lib

# Ignorar configurações e arquivos temporários de IDEs e editores de código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Ignorar arquivos de ambiente (muito importante!)
.env
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.local

# Ignorar caches de test runner
/coverage

# Ignorar arquivos temporários de sistemas operacionais
*.log
*.tmp
*.bak
*.swp

# Ignorar dados de banco de dados e arquivos de volume
/data

# Ignorar o cache do Jest
/jest-cache

# Ignorar o cache do npm/yarn
.npm/
.yarn/